{
  "name": "@turfit/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/check-config.ts development && next dev",
    "build": "node scripts/check-config.ts production && prisma generate && next build",
    "start": "node scripts/check-config.ts production && next start",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev --create-only",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "node --conditions=react-server --import tsx --test test/unit/*.test.ts",
    "test:db": "node --conditions=react-server --import tsx --test --test-concurrency=1 test/database/*.test.ts",
    "auth:create-admin": "node --conditions=react-server --import tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@next/env": "16.4.3",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "17.4.2",
    "jose": "6.2.14",
    "next": "16.4.3",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
