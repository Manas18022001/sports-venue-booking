# Development only. Use a dedicated database and secret-managed credentials in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/turfit?schema=public

# Optional server settings. Values shown below are the defaults.
# Limits apply per application process/instance, not across the deployment.
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

# Use the exact browser origin, including its port. Set the deployed HTTPS
# origin in production. This value is never inferred from request headers.
APP_ORIGIN=http://localhost:3000
API_MAX_BODY_BYTES=65536
API_MAX_URL_BYTES=8192
API_BODY_TIMEOUT_MS=10000
LOG_LEVEL=info

# Tests create and remove an isolated schema in a dedicated test database.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/turfit_test
